# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
# Never commit .env — it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# Supabase (server-side only — used by app/api routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# n8n webhooks (server-side only — proxied by /api/chat/send and /api/chat/poll)
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/your-send-id
N8N_POLLING_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/your-poll-id

# Origin allowed to call the public chat proxy routes from an embedded widget.
# Use * to allow any site, or set it to a single origin (e.g. https://example.com).
CHAT_ALLOWED_ORIGIN=*

# Public API paths used by the browser (safe to expose)
NEXT_PUBLIC_CHAT_SEND_API_URL=/api/chat/send
NEXT_PUBLIC_CHAT_MESSAGES_API_URL=/api/chat/messages
